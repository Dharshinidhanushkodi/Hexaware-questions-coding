import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		String s=sc.nextLine();
		int count=0;
		int max=0;
		for(int i=0;i<s.length();i++)
		{
		    count++;
		    if(s.charAt(i)=='@' || s.charAt(i)=='$')
		    {
		        max=Math.max(count,max);
		        count=0;
		    }
		}
		max=Math.max(max,count);
		System.out.print(max);
	}
}
