import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
	   int arr[]=new int[n];
	   for(int i=0;i<n;i++)
	   {
	       arr[i]=sc.nextInt();
	   }
		int min=Integer.MAX_VALUE;
		int min2=Integer.MAX_VALUE;
		for(int i=0;i<n;i++)
		{
		    if(arr[i]<min)
		    {
		        min2=min;
		        min=arr[i];
		    }
		    else if(arr[i]>min && arr[i]<min2)
		    {
		        min2=arr[i];
		    }
		}
		System.out.print(min2);
	}
}
