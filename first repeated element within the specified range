import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int arr[]=new int[n];
		for(int i=0;i<n;i++)
		{
		    arr[i]=sc.nextInt();
		}
		int s=sc.nextInt();
		int e=sc.nextInt();
		
		for(int i=s;i<e;i++)
		{
		  int c=0;
		  for(int j=i+1;j<e;j++)
		  {
		      if(arr[i]==arr[j])
		      {
		          c++;
		      }
		  }
		if(c>0)
		{
		    System.out.print(arr[i]);
		    return;
		}
		
	}
	}
}
