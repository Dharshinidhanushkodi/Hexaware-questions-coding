import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
	    String s=sc.nextLine();
	    String res="";
	    for(int i=0;i<s.length();i++)
	    {
	        char c=s.charAt(i);
	        res=res+(char)(c+1);
	    }
		System.out.print(res);
	}
}
