import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
	    int n=sc.nextInt();
	    int m=sc.nextInt();
	    int o=sc.nextInt();
	    int sum=0;
	    for(int i=n;i<m;i++)
	    {
	        sum=sum+i;
	    }
	    for(int j=o;j<=m;j++)
	    {
	        sum=sum+j;
	    }
	    System.out.print(sum);
	}
}
